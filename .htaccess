# Pet Holiday – petholidayinn.ro (hosting Hostico, Apache)

# HTTPS și fără www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://petholidayinn.ro%{REQUEST_URI} [L,R=301]

# Fișierele de lucru nu sunt publice
RedirectMatch 404 /\.(git|github|claude)(/|$)

# Diacriticele afișate corect
AddDefaultCharset UTF-8

# Cache: imagini și fonturi un an, CSS/JS o săptămână (au ?v= în link), HTML mereu proaspăt
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compresie
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Antete de siguranță
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /index.html
